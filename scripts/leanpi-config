#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: leanpi-config <command> [args]

Commands:
  get <key>             Read a configuration value
  set <key> <value>     Set a configuration value
  list                  List LeanPi configuration
  board                 Print board identity
  hostname [NAME]       Get or idempotently set hostname
  timezone [ZONE]       Get or idempotently set timezone
  logging [MODE]        Get/set logging: volatile, hybrid, persistent
  help                  Show this help

Configuration is stored as key=value in /etc/leanpi/config.
Commands are non-interactive and intended for humans, scripts and provisioning.
EOF
}

config=/etc/leanpi/config

valid_key() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) return 1 ;;
        *) return 0 ;;
    esac
}

get_value() {
    valid_key "$1" || { echo "Invalid key: $1" >&2; exit 2; }
    [ -f "$config" ] || exit 1
    value=$(awk -F= -v k="$1" '$1 == k {sub(/^[^=]*=/, ""); print; found=1; exit} END {if (!found) exit 1}' "$config") ||
        exit 1
    printf '%s\n' "$value"
}

set_value() {
    key=$1
    value=$2
    valid_key "$key" || { echo "Invalid key: $key" >&2; exit 2; }
    case "$value" in *'
'*|*'\r'*) echo "Multiline values are not supported" >&2; exit 2;; esac
    mkdir -p /etc/leanpi
    tmp=$(mktemp /etc/leanpi/config.XXXXXX)
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    if [ -f "$config" ]; then
        awk -F= -v k="$key" '$1 != k' "$config" > "$tmp"
    fi
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$config"
    trap - EXIT HUP INT TERM
}

set_hostname() {
    name=$1
    current=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || true)
    [ "$current" = "$name" ] && return 0
    printf '%s\n' "$name" > /etc/hostname
    if command -v hostnamectl >/dev/null 2>&1; then hostnamectl set-hostname "$name"; else hostname "$name"; fi
}

set_logging() {
    mode=$1
    case "$mode" in
        volatile) storage=volatile ;;
        persistent) storage=persistent ;;
        hybrid) storage=auto ;;
        *) echo "Invalid logging mode: $mode" >&2; exit 2 ;;
    esac
    dir=/etc/systemd/journald.conf.d
    file=$dir/leanpi.conf
    wanted="[Journal]
Storage=$storage
"
    current=$(cat "$file" 2>/dev/null || true)
    [ "$current" = "$wanted" ] && return 0
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/leanpi.conf.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    printf '%s' "$wanted" > "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$file"
    trap - EXIT HUP INT TERM
    if command -v systemctl >/dev/null 2>&1; then systemctl try-restart systemd-journald.service >/dev/null 2>&1 || true; fi
}

get_logging() {
    value=$(awk -F= '/^Storage=/ {print $2; exit}' /etc/systemd/journald.conf.d/leanpi.conf 2>/dev/null || true)
    case "$value" in
        volatile) echo volatile ;;
        persistent) echo persistent ;;
        auto|"") echo hybrid ;;
        *) echo "$value" ;;
    esac
}

set_timezone() {
    zone=$1
    target=/usr/share/zoneinfo/$zone
    [ -e "$target" ] || { echo "Unknown timezone: $zone" >&2; exit 2; }
    current=$(cat /etc/timezone 2>/dev/null || true)
    [ "$current" = "$zone" ] && [ "$(readlink /etc/localtime 2>/dev/null || true)" = "$target" ] && return 0
    ln -snf "$target" /etc/localtime
    printf '%s\n' "$zone" > /etc/timezone
}

case "${1:-help}" in
    get) [ "$#" -eq 2 ] || { usage >&2; exit 2; }; get_value "$2" ;;
    set) [ "$#" -eq 3 ] || { usage >&2; exit 2; }; set_value "$2" "$3" ;;
    list) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; [ ! -f "$config" ] || cat "$config" ;;
    hostname)
        case "$#" in
            1) hostname ;;
            2) set_hostname "$2" ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    logging)
        case "$#" in
            1) get_logging ;;
            2) set_logging "$2" ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    timezone)
        case "$#" in
            1) cat /etc/timezone 2>/dev/null || readlink /etc/localtime | sed 's#^/usr/share/zoneinfo/##' ;;
            2) set_timezone "$2" ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    board)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        if [ -r /etc/leanpi/board ]; then cat /etc/leanpi/board
        elif [ -r /proc/device-tree/model ]; then tr -d '\000' < /proc/device-tree/model; printf '\n'
        else uname -m
        fi
        ;;
    help|-h|--help) usage ;;
    *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
